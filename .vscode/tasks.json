{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build with g++",
            "type": "shell",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "windows": {
                "command": "cmd",
                "args": [
                    "/c",
                    "if not exist \"${workspaceFolder}\\build\" mkdir \"${workspaceFolder}\\build\" && C:\\msys64\\ucrt64\\bin\\g++.exe -std=c++20 -Wall -Wextra -Wshadow -g \"${file}\" -o \"${workspaceFolder}\\build\\${fileBasenameNoExtension}.exe\""
                ]
            },
            "linux": {
                "command": "bash",
                "args": [
                    "-c",
                    "mkdir -p \"${workspaceFolder}/build\" && g++ -std=c++20 -Wall -Wextra -Wshadow -g \"${file}\" -o \"${workspaceFolder}/build/${fileBasenameNoExtension}\""
                ]
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}